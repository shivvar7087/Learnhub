# Frontend API URL (Vite)
VITE_API_URL=http://127.0.0.1:8001

# FastAPI CORS and file uploads
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=./uploads

# Backend JWT authentication. Generate a unique random secret for each environment.
JWT_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional shared rate-limit storage for multi-instance deployments (for example Redis).
# RATE_LIMIT_STORAGE_URI=redis://USER:PASSWORD@HOST:6379/0

# Optional: leave DATABASE_URL unset for local SQLite.
# To use a different PostgreSQL provider, set a SQLAlchemy URL:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
